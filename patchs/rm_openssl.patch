+type ImapTlsStream = StreamOwned<ClientConnection, TcpStream>;
+
+fn build_imap_root_store() -> RootCertStore {
+    let mut roots = RootCertStore::empty();
+    roots.extend(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
+
+    let native_certs = rustls_native_certs::load_native_certs();
+    if !native_certs.errors.is_empty() {
+        warn!(
+            error_count = native_certs.errors.len(),
+            "Some native CA certificates could not be loaded for IMAP TLS"
+        );
+    }
+
+    let (added, ignored) = roots.add_parsable_certificates(native_certs.certs);
+    debug!(
+        native_certs_added = added,
+        native_certs_ignored = ignored,
+        "Loaded native CA certificates for IMAP TLS"
+    );
+
+    roots
+}
+
+fn connect_imap_tls(host: &str, port: u16) -> Result<imap::Client<ImapTlsStream>, String> {
+    let stream =
+        TcpStream::connect((host, port)).map_err(|e| format!("IMAP connect failed: {e}"))?;
+    let server_name = ServerName::try_from(host.to_string())
+        .map_err(|_| format!("invalid IMAP server name: {host}"))?;
+    let config = ClientConfig::builder()
+        .with_root_certificates(build_imap_root_store())
+        .with_no_client_auth();
+    let tls = ClientConnection::new(Arc::new(config), server_name)
+        .map_err(|e| format!("IMAP TLS setup failed: {e}"))?;
+    let mut client = imap::Client::new(StreamOwned::new(tls, stream));
+    client
+        .read_greeting()
+        .map_err(|e| format!("IMAP greeting failed: {e}"))?;
+    Ok(client)
+}
